// みんなの声（民意を集める投票サイト）を Cloudflare Workers + D1 で公開する設定
{
  "name": "minnano-koe",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /api/* だけ Worker で処理し、それ以外は静的ファイルを返す
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minnano-koe",
      // `npx wrangler d1 create minnano-koe` で表示された ID に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    // 持ち越せる票の上限（溜め込みすぎ防止）
    "MAX_BALANCE": "3"
  }
  // 管理者トークンは `npx wrangler secret put ADMIN_TOKEN` で設定する（ここには書かない）
}
